generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  phone              String?
  address            String?
  birthDate          DateTime?
  role               Role                @default(CLIENTE)
  points             Int                 @default(0)
  levelId            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  challengeProgress  ChallengeProgress[]
  codeRedemptions    CodeRedemption[]
  gameSessions       GameSession[]
  orders             Order[]
  pointsTransactions PointsTransaction[]
  redemptions        Redemption[]
  createdCodes       RedemptionCode[]    @relation("CodeCreator")
  sessions           Session[]
  stampCard          StampCard?
  claimedStamps      StampQR[]           @relation("StampClaimer")
  generatedStamps    StampQR[]           @relation("StampGenerator")
  level              Level?              @relation(fields: [levelId], references: [id])

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@index([email])
}

model Level {
  id         String   @id @default(cuid())
  name       String   @unique
  minPoints  Int
  multiplier Float    @default(1)
  color      String   @default("#E85C2B")
  icon       String   @default("flame")
  benefits   String[]
  order      Int      @default(0)
  users      User[]

  @@index([order])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String?
  order     Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([order])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  price       Int
  image       String?
  categoryId  String
  ingredients String[]
  featured    Boolean        @default(false)
  available   Boolean        @default(true)
  spicyLevel  Int            @default(0)
  calories    Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orderItems  OrderItem[]
  category    Category       @relation(fields: [categoryId], references: [id])
  extras      ProductExtra[]

  @@index([categoryId])
  @@index([featured])
  @@index([available])
}

model ProductExtra {
  id        String  @id @default(cuid())
  name      String
  price     Int     @default(0)
  productId String
  active    Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                 String              @id @default(cuid())
  userId             String
  status             OrderStatus         @default(PENDIENTE)
  deliveryType       DeliveryType        @default(DOMICILIO)
  address            String?
  notes              String?
  subtotal           Int
  deliveryFee        Int                 @default(0)
  tax                Int                 @default(0)
  discount           Int                 @default(0)
  total              Int
  couponCode         String?
  pointsEarned       Int                 @default(0)
  whatsappSent       Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id])
  items              OrderItem[]
  pointsTransactions PointsTransaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Int
  notes     String?
  extras    Json?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model PointsTransaction {
  id          String     @id @default(cuid())
  userId      String
  orderId     String?
  points      Int
  type        PointsType
  description String
  createdAt   DateTime   @default(now())
  order       Order?     @relation(fields: [orderId], references: [id])
  user        User       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
}

model RedemptionCode {
  id          String           @id @default(cuid())
  code        String           @unique
  pointsValue Int
  description String?
  maxUses     Int              @default(1)
  uses        Int              @default(0)
  active      Boolean          @default(true)
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime         @default(now())
  redemptions CodeRedemption[]
  createdBy   User             @relation("CodeCreator", fields: [createdById], references: [id])

  @@index([code])
  @@index([active])
}

model CodeRedemption {
  id               String         @id @default(cuid())
  userId           String
  redemptionCodeId String
  pointsEarned     Int
  createdAt        DateTime       @default(now())
  redemptionCode   RedemptionCode @relation(fields: [redemptionCodeId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@unique([userId, redemptionCodeId])
  @@index([redemptionCodeId])
}

model Challenge {
  id                String              @id @default(cuid())
  title             String
  description       String
  type              ChallengeType
  goal              Int
  rewardPoints      Int                 @default(0)
  rewardDescription String?
  badgeIcon         String              @default("trophy")
  active            Boolean             @default(true)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  progress          ChallengeProgress[]

  @@index([active])
}

model ChallengeProgress {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, challengeId])
  @@index([userId])
}

model Reward {
  id          String       @id @default(cuid())
  name        String
  description String?
  pointsCost  Int
  image       String?
  stock       Int?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  redemptions Redemption[]

  @@index([active])
}

model Redemption {
  id          String           @id @default(cuid())
  userId      String
  rewardId    String
  pointsSpent Int
  code        String           @unique
  status      RedemptionStatus @default(PENDIENTE)
  createdAt   DateTime         @default(now())
  reward      Reward           @relation(fields: [rewardId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([code])
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  discountType DiscountType
  value        Int
  minOrder     Int          @default(0)
  usageLimit   Int?
  used         Int          @default(0)
  active       Boolean      @default(true)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())

  @@index([code])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([order])
}

model Review {
  id         String   @id @default(cuid())
  authorName String
  rating     Int
  comment    String
  avatar     String?
  approved   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model GameSession {
  id        String   @id @default(cuid())
  userId    String
  game      String
  score     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, game, createdAt])
  @@index([game, score])
}

model Settings {
  key   String @id
  value String
}

model StampCard {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentStamps   Int       @default(0)
  cardsCompleted  Int       @default(0)
  rewardReady     Boolean   @default(false)
  rewardClaimedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])
  stamps          StampQR[]
}

model StampQR {
  id            String        @id @default(cuid())
  token         String        @unique
  status        StampQRStatus @default(PENDIENTE)
  generatedById String
  claimedById   String?
  claimedAt     DateTime?
  stampCardId   String?
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
  claimedBy     User?         @relation("StampClaimer", fields: [claimedById], references: [id])
  generatedBy   User          @relation("StampGenerator", fields: [generatedById], references: [id])
  stampCard     StampCard?    @relation(fields: [stampCardId], references: [id])

  @@index([token])
  @@index([status])
  @@index([expiresAt])
}

enum Role {
  CLIENTE
  ADMIN
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum DeliveryType {
  DOMICILIO
  RECOGE_EN_TIENDA
}

enum PointsType {
  GANADO_COMPRA
  GANADO_CODIGO
  GANADO_DESAFIO
  CANJEADO
  AJUSTE_ADMIN
  BONO_BIENVENIDA
}

enum ChallengeType {
  CANTIDAD_PRODUCTO
  PEDIDOS_TOTALES
  RACHA_SEMANAS
  REFERIDO
  PRODUCTO_NUEVO
  CUMPLEANOS
  CATEGORIA_COMPLETA
  COMBO
}

enum RedemptionStatus {
  PENDIENTE
  ENTREGADO
  CANCELADO
}

enum DiscountType {
  PORCENTAJE
  FIJO
}

enum StampQRStatus {
  PENDIENTE
  RECLAMADO
  EXPIRADO
}
