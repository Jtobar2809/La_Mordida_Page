generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  phone              String?
  address            String?
  birthDate          DateTime?
  role               Role                @default(CLIENTE)
  points             Int                 @default(0)
  levelId            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  challengeProgress  ChallengeProgress[]
  codeRedemptions    CodeRedemption[]
  gameSessions       GameSession[]
  orders             Order[]
  pointsTransactions PointsTransaction[]
  redemptions        Redemption[]
  createdCodes       RedemptionCode[]    @relation("CodeCreator")
  sessions           Session[]
  stampCard          StampCard?
  claimedStamps      StampQR[]           @relation("StampClaimer")
  generatedStamps    StampQR[]           @relation("StampGenerator")
  level              Level?              @relation(fields: [levelId], references: [id])
  cajasAbiertas      CajaSesion[]        @relation("CajaAbiertaPor")
  cajasCerradas      CajaSesion[]        @relation("CajaCerradaPor")

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@index([email])
}

model Level {
  id         String   @id @default(cuid())
  name       String   @unique
  minPoints  Int
  multiplier Float    @default(1)
  color      String   @default("#E85C2B")
  icon       String   @default("flame")
  benefits   String[]
  order      Int      @default(0)
  users      User[]

  @@index([order])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String?
  order     Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([order])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  price       Int
  image       String?
  categoryId  String
  ingredients String[]
  featured    Boolean        @default(false)
  available   Boolean        @default(true)
  spicyLevel  Int            @default(0)
  calories    Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orderItems  OrderItem[]
  category    Category       @relation(fields: [categoryId], references: [id])
  extras      ProductExtra[]
  recetaItems RecetaItem[]

  @@index([categoryId])
  @@index([featured])
  @@index([available])
}

model ProductExtra {
  id        String  @id @default(cuid())
  name      String
  price     Int     @default(0)
  productId String
  active    Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Receta del extra. Un adicional casi siempre es "más de un solo insumo"
  // (extra queso = 30g de queso, extra tocineta = 25g de tocineta), así que no
  // hace falta una tabla de receta aparte: basta con apuntar al insumo y decir
  // cuánto consume. Sin esto, los extras se cobraban pero NO descontaban nada
  // del inventario, y el queso "desaparecía" sin explicación en el arqueo.
  // Ambos campos son opcionales: un extra sin insumo asociado (ej. "sin
  // cebolla", "término tres cuartos") simplemente no descuenta.
  insumoId       String?
  cantidadInsumo Float?
  insumo         Insumo? @relation(fields: [insumoId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([insumoId])
}

model Insumo {
  id                   String             @id @default(cuid())
  nombre               String             @unique
  unidad               UnidadInsumo
  stockActual          Float              @default(0)
  stockMinimo          Float              @default(0)
  costoUnitario        Int                @default(0)
  proveedor            String?
  proveedorPrincipalId String?
  fechaVencimiento     DateTime?
  esElaborado          Boolean            @default(false)
  activo               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  recetaItems          RecetaItem[]
  movimientos          MovimientoInsumo[]
  compraItems          CompraItem[]
  proveedorPrincipal   Proveedor?         @relation(fields: [proveedorPrincipalId], references: [id])
  composicion          InsumoComponente[] @relation("Composicion")
  usadoComoBaseEn      InsumoComponente[] @relation("UsadoComoBase")
  extras               ProductExtra[]
  producciones         Produccion[]

  @@index([activo])
  @@index([proveedorPrincipalId])
}

// Receta / BOM: qué insumos y en qué cantidad componen cada producto del menú.
// Es la pieza que permite descontar stock automático en fases posteriores.
model RecetaItem {
  id        String   @id @default(cuid())
  productId String
  insumoId  String
  cantidad  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  insumo    Insumo   @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@unique([productId, insumoId])
  @@index([productId])
  @@index([insumoId])
}

// Insumos elaborados: algunos insumos (salsas, mezclas) no se compran directo,
// se preparan combinando otros insumos base. InsumoComponente modela esa
// "receta interna": cuánto de un insumo base entra por cada 1 [unidad del
// insumo elaborado] (ej. 0.4g de mayonesa por cada 1g de aderezo).
model InsumoComponente {
  id                String   @id @default(cuid())
  insumoElaboradoId String
  insumoBaseId      String
  cantidad          Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  insumoElaborado   Insumo   @relation("Composicion", fields: [insumoElaboradoId], references: [id], onDelete: Cascade)
  insumoBase        Insumo   @relation("UsadoComoBase", fields: [insumoBaseId], references: [id], onDelete: Restrict)

  @@unique([insumoElaboradoId, insumoBaseId])
  @@index([insumoElaboradoId])
  @@index([insumoBaseId])
}

// Un lote preparado de un insumo elaborado (una olla de aderezo, una tanda de
// cebolla caramelizada). Es la pieza que le faltaba a `InsumoComponente`:
// antes existía la "receta interna" de los elaborados pero nada la ejecutaba,
// así que vender una hamburguesa descontaba 30g de aderezo del stock del
// aderezo... y la mayonesa, la mostaza y los pepinillos que lo componen se
// quedaban intactos en el sistema para siempre. Registrar una Producción cierra
// ese hueco: suma stock al elaborado y descuenta sus componentes, todo en la
// misma transacción y todo trazado en MovimientoInsumo.
model Produccion {
  id                String   @id @default(cuid())
  insumoElaboradoId String
  cantidad          Float
  // Costo unitario del elaborado calculado a partir de lo que costaron sus
  // componentes en ESTE lote, no de una tabla de precios teórica.
  costoUnitario     Int      @default(0)
  notas             String?
  createdById       String?
  createdAt         DateTime @default(now())
  insumoElaborado   Insumo   @relation(fields: [insumoElaboradoId], references: [id], onDelete: Restrict)

  @@index([insumoElaboradoId])
  @@index([createdAt])
}

// Libro mayor de inventario: toda entrada, salida, merma o ajuste queda trazada aquí.
model MovimientoInsumo {
  id            String         @id @default(cuid())
  insumoId      String
  tipo          MovimientoTipo
  cantidad      Float
  costoUnitario Int?
  motivo        String?
  orderId       String?
  produccionId  String?
  createdById   String?
  createdAt     DateTime       @default(now())
  insumo        Insumo         @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@index([insumoId])
  @@index([tipo])
  @@index([createdAt])
  @@index([orderId])
  @@index([produccionId])
}

// Fase 3: proveedores y compras. Registrar una Compra descuenta... perdón,
// SUMA stock (ENTRADA) y recalcula el costo promedio ponderado del insumo,
// reutilizando el mismo libro mayor MovimientoInsumo de la Fase 1.
model Proveedor {
  id        String   @id @default(cuid())
  nombre    String   @unique
  contacto  String?
  telefono  String?
  email     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  insumos   Insumo[]
  compras   Compra[]

  @@index([activo])
}

model Compra {
  id          String       @id @default(cuid())
  proveedorId String
  fecha       DateTime     @default(now())
  total       Int          @default(0)
  notas       String?
  createdById String?
  createdAt   DateTime     @default(now())
  proveedor   Proveedor    @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  items       CompraItem[]

  @@index([proveedorId])
  @@index([fecha])
}

model CompraItem {
  id            String @id @default(cuid())
  compraId      String
  insumoId      String
  cantidad      Float
  costoUnitario Int
  compra        Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)
  insumo        Insumo @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@index([compraId])
  @@index([insumoId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CAJA
// ─────────────────────────────────────────────────────────────────────────────

/// Un turno de caja: se abre con una base en efectivo, acumula ventas,
/// ingresos y egresos, y se cierra contando la plata física (arqueo).
///
/// Los totales NO se guardan mientras la caja está abierta — se calculan al
/// vuelo sumando los movimientos, que son la única fuente de verdad. Solo al
/// cerrar se congela un snapshot (`totalVentas`, `esperadoEfectivo`, etc.) para
/// que el arqueo histórico de un turno del mes pasado siga mostrando los mismos
/// números aunque después se corrija un pedido viejo.
model CajaSesion {
  id     String     @id @default(cuid())
  codigo String     @unique
  estado CajaEstado @default(ABIERTA)

  /// Base en efectivo con la que arranca el turno (para dar vueltas).
  montoInicial  Int      @default(0)
  abiertaPorId  String
  abiertaAt     DateTime @default(now())
  notasApertura String?

  cerradaPorId    String?
  cerradaAt       DateTime?
  notasCierre     String?
  /// Efectivo físico contado por quien cierra. Null mientras esté abierta.
  efectivoContado Int?

  // Snapshot congelado al cerrar (todos null mientras la caja está abierta).
  totalVentas      Int?
  totalEfectivo    Int?
  totalNequi       Int?
  totalOtros       Int?
  totalIngresos    Int?
  totalEgresos     Int?
  /// montoInicial + efectivo de ventas + ingresos − egresos.
  esperadoEfectivo Int?
  /// efectivoContado − esperadoEfectivo. Negativo = falta plata.
  diferencia       Int?

  /// Truco de integridad: en Postgres cada NULL de un índice único cuenta como
  /// un valor distinto, así que este campo vale `true` mientras el turno está
  /// abierto y pasa a `null` al cerrarlo. Resultado: es la BASE DE DATOS la que
  /// garantiza que nunca existan dos cajas abiertas a la vez, no un `if` en el
  /// servidor que dos clics simultáneos pueden esquivar.
  abiertaLock Boolean? @unique

  abiertaPor  User             @relation("CajaAbiertaPor", fields: [abiertaPorId], references: [id])
  cerradaPor  User?            @relation("CajaCerradaPor", fields: [cerradaPorId], references: [id])
  movimientos MovimientoCaja[]
  ordenes     Order[]

  @@index([estado])
  @@index([abiertaAt])
}

/// Cada entrada y salida de plata del turno. Una venta con pago mixto genera
/// varias filas (una por método), por eso el monto vive aquí y no en Order.
model MovimientoCaja {
  id          String             @id @default(cuid())
  sesionId    String
  tipo        MovimientoCajaTipo
  metodo      MetodoPago
  /// Siempre positivo. El signo lo define `tipo` (EGRESO resta), para que no
  /// existan dos representaciones de la misma salida de dinero.
  monto       Int
  concepto    String
  orderId     String?
  createdById String?
  createdAt   DateTime           @default(now())

  sesion CajaSesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  order  Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([sesionId])
  @@index([tipo])
  @@index([orderId])
  @@index([createdAt])
}

model Order {
  id                   String       @id @default(cuid())
  userId               String
  status               OrderStatus  @default(PENDIENTE)
  deliveryType         DeliveryType @default(DOMICILIO)
  address              String?
  notes                String?
  subtotal             Int
  deliveryFee          Int          @default(0)
  tax                  Int          @default(0)
  discount             Int          @default(0)
  total                Int
  couponCode           String?
  pointsEarned         Int          @default(0)
  whatsappSent         Boolean      @default(false)
  inventarioDescontado Boolean      @default(false)

  /// De dónde vino la venta. WEB = checkout del cliente, CAJA = mostrador.
  /// Sin esto el reporte de caja no puede distinguir la plata que realmente
  /// entró al cajón de los pedidos que se pagan contra entrega en la calle.
  canal            OrderCanal  @default(WEB)
  cajaSesionId     String?
  /// Método principal de pago. El desglose real vive en MovimientoCaja (una
  /// venta puede pagarse parte en efectivo y parte por Nequi); este campo es
  /// el atajo para listar y filtrar pedidos sin hacer un join.
  metodoPago       MetodoPago?
  /// Solo para pagos en efectivo: cuánto entregó el cliente y cuánto se le
  /// devolvió. Se guarda para que el ticket sea reimprimible tal cual.
  efectivoRecibido Int?
  cambio           Int?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id])
  items              OrderItem[]
  pointsTransactions PointsTransaction[]
  cajaSesion         CajaSesion?         @relation(fields: [cajaSesionId], references: [id], onDelete: SetNull)
  movimientosCaja    MovimientoCaja[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([canal])
  @@index([cajaSesionId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Int
  notes     String?
  extras    Json?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model PointsTransaction {
  id          String     @id @default(cuid())
  userId      String
  orderId     String?
  points      Int
  type        PointsType
  description String
  createdAt   DateTime   @default(now())
  order       Order?     @relation(fields: [orderId], references: [id])
  user        User       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
}

model RedemptionCode {
  id          String           @id @default(cuid())
  code        String           @unique
  pointsValue Int
  description String?
  maxUses     Int              @default(1)
  uses        Int              @default(0)
  active      Boolean          @default(true)
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime         @default(now())
  redemptions CodeRedemption[]
  createdBy   User             @relation("CodeCreator", fields: [createdById], references: [id])

  @@index([code])
  @@index([active])
}

model CodeRedemption {
  id               String         @id @default(cuid())
  userId           String
  redemptionCodeId String
  pointsEarned     Int
  createdAt        DateTime       @default(now())
  redemptionCode   RedemptionCode @relation(fields: [redemptionCodeId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@unique([userId, redemptionCodeId])
  @@index([redemptionCodeId])
}

model Challenge {
  id                String              @id @default(cuid())
  title             String
  description       String
  type              ChallengeType
  goal              Int
  rewardPoints      Int                 @default(0)
  rewardDescription String?
  badgeIcon         String              @default("trophy")
  active            Boolean             @default(true)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  progress          ChallengeProgress[]

  @@index([active])
}

model ChallengeProgress {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, challengeId])
  @@index([userId])
}

model Reward {
  id          String       @id @default(cuid())
  name        String
  description String?
  pointsCost  Int
  image       String?
  stock       Int?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  redemptions Redemption[]

  @@index([active])
}

model Redemption {
  id          String           @id @default(cuid())
  userId      String
  rewardId    String
  pointsSpent Int
  code        String           @unique
  status      RedemptionStatus @default(PENDIENTE)
  createdAt   DateTime         @default(now())
  reward      Reward           @relation(fields: [rewardId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([code])
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  discountType DiscountType
  value        Int
  minOrder     Int          @default(0)
  usageLimit   Int?
  used         Int          @default(0)
  active       Boolean      @default(true)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())

  @@index([code])
}

model Banner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  order     Int             @default(0)
  active    Boolean         @default(true)
  placement BannerPlacement @default(PROMOCIONES)
  createdAt DateTime        @default(now())

  @@index([order])
  @@index([placement])
}

model GalleryImage {
  id        String   @id @default(cuid())
  image     String
  alt       String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([order])
}

model Review {
  id         String   @id @default(cuid())
  authorName String
  rating     Int
  comment    String
  avatar     String?
  approved   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

/// Identidad de un jugador sin cuenta. El código es público (se muestra
/// en la tabla de posiciones como "Anónimo #XXXXXX") y es la clave
/// primaria, así que Postgres garantiza que sea irrepetible.
model GuestPlayer {
  code      String   @id
  createdAt DateTime @default(now())
}

/// Una partida jugada. Puede pertenecer a un usuario registrado o a un
/// invitado: la tabla de posiciones agrupa por `playerKey`, que vale
/// "u:<userId>" para usuarios y "g:<guestCode>" para invitados. Así el
/// leaderboard es una sola consulta, sin COALESCE ni UNION, y todo el
/// mundo aparece en la tabla aunque no se haya registrado.
model GameSession {
  id        String   @id @default(cuid())
  playerKey String
  userId    String?
  guestCode String?
  game      String
  score     Int
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, game, createdAt])
  @@index([game, score])
  @@index([game, playerKey])
  @@index([guestCode])
}

model Settings {
  key   String @id
  value String
}

model StampCard {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentStamps   Int       @default(0)
  cardsCompleted  Int       @default(0)
  rewardReady     Boolean   @default(false)
  rewardClaimedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])
  stamps          StampQR[]
}

model StampQR {
  id            String        @id @default(cuid())
  token         String        @unique
  status        StampQRStatus @default(PENDIENTE)
  generatedById String
  claimedById   String?
  claimedAt     DateTime?
  stampCardId   String?
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
  claimedBy     User?         @relation("StampClaimer", fields: [claimedById], references: [id])
  generatedBy   User          @relation("StampGenerator", fields: [generatedById], references: [id])
  stampCard     StampCard?    @relation(fields: [stampCardId], references: [id])

  @@index([token])
  @@index([status])
  @@index([expiresAt])
}

enum Role {
  CLIENTE
  ADMIN
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum DeliveryType {
  DOMICILIO
  RECOGE_EN_TIENDA
}

enum PointsType {
  GANADO_COMPRA
  GANADO_CODIGO
  GANADO_DESAFIO
  CANJEADO
  AJUSTE_ADMIN
  BONO_BIENVENIDA
}

enum ChallengeType {
  CANTIDAD_PRODUCTO
  PEDIDOS_TOTALES
  RACHA_SEMANAS
  REFERIDO
  PRODUCTO_NUEVO
  CUMPLEANOS
  CATEGORIA_COMPLETA
  COMBO
}

enum RedemptionStatus {
  PENDIENTE
  ENTREGADO
  CANCELADO
}

enum DiscountType {
  PORCENTAJE
  FIJO
}

enum StampQRStatus {
  PENDIENTE
  RECLAMADO
  EXPIRADO
}

enum BannerPlacement {
  HERO
  PROMOCIONES
}

enum UnidadInsumo {
  GRAMOS
  KILOGRAMOS
  MILILITROS
  LITROS
  UNIDAD
}

enum MovimientoTipo {
  ENTRADA
  SALIDA
  AJUSTE
  MERMA
  /// Entrada de un insumo elaborado que se preparó en cocina. Se separa de
  /// ENTRADA a propósito: una ENTRADA es plata que salió a comprarle a un
  /// proveedor, una PRODUCCION no compra nada, solo transforma insumos que ya
  /// estaban en la bodega. Mezclarlos inflaría el costo de compras del mes.
  PRODUCCION
}

enum CajaEstado {
  ABIERTA
  CERRADA
}

enum MovimientoCajaTipo {
  VENTA
  /// Plata que entra por fuera de una venta (base adicional, cobro pendiente).
  INGRESO
  /// Plata que sale: pago a proveedor, domicilio, retiro a la caja fuerte.
  EGRESO
}

