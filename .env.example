# ─────────────────────────────────────────────
# BASE DE DATOS (Neon o Supabase Postgres)
# ─────────────────────────────────────────────
# Cadena de conexión "pooled" (para runtime serverless)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
# Cadena de conexión directa (para migraciones de Prisma)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─────────────────────────────────────────────
# AUTH.JS / NEXTAUTH
# ─────────────────────────────────────────────
# Genera uno con: openssl rand -base64 32
AUTH_SECRET="reemplaza-esto-con-un-secreto-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# OAuth de Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# CORREO (Resend — recuperar contraseña, bienvenida)
# ─────────────────────────────────────────────
# Crea una cuenta gratis en https://resend.com y verifica tu dominio
# (o usa el dominio de pruebas onboarding@resend.dev mientras tanto)
RESEND_API_KEY=""
EMAIL_FROM="La Mordida <pedidos@tudominio.com>"

# ─────────────────────────────────────────────
# CLOUDINARY (subida de imágenes de productos, banners, etc.)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─────────────────────────────────────────────
# NEGOCIO
# ─────────────────────────────────────────────
# Número de WhatsApp del restaurante en formato internacional sin "+" (ej: 573001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER="573000000000"

# ─────────────────────────────────────────────
# SEO
# ─────────────────────────────────────────────
# Código de verificación de Google Search Console (propiedad tipo "etiqueta HTML").
# search.google.com/search-console -> Agregar propiedad -> Etiqueta HTML -> copia
# solo el valor del atributo content="..." (no la etiqueta <meta> completa).
GOOGLE_SITE_VERIFICATION=""

# ─────────────────────────────────────────────
# Monitoreo de errores (opcional)
# ─────────────────────────────────────────────
# Sin estas variables el monitoreo simplemente no se activa: la app funciona
# igual y no se envía nada. Crea un proyecto en sentry.io (capa gratis) y pega
# el DSN aquí para empezar a recibir avisos cuando algo falle en producción.
#
# El del servidor y el del navegador son el mismo valor; van en dos variables
# porque el segundo viaja al navegador y queda a la vista de cualquiera.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Solo si quieres que los errores lleguen con el código legible en vez del
# minificado. Se saca de sentry.io -> Settings -> Auth Tokens.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
